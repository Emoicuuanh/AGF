# Nodes / scripts / configs run on Linux: a CRLF shebang (python3 + CR) cannot start
*.py      text eol=lf
*.sh      text eol=lf
*.launch  text eol=lf
*.xacro   text eol=lf
*.yaml    text eol=lf
*.srv     text eol=lf
*.xml     text eol=lf
*.sdf     text eol=lf
*.world   text eol=lf
*.rviz    text eol=lf
*.md      text eol=lf
CMakeLists.txt text eol=lf
