<!-- ROS Noetic Launch File for AGF Model with Ackermann Steering -->
<launch>
  <!-- Launch arguments -->
  <arg name="model" default="$(find agf_gazebo_sim)/urdf/agf_model.xacro"/>
  <arg name="world_name" default="empty.world"/>
  <arg name="x" default="0"/>
  <arg name="y" default="0"/>
  <arg name="z" default="0.1"/>
  <arg name="roll" default="0"/>
  <arg name="pitch" default="0"/>
  <arg name="yaw" default="0"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>

  <!-- Set use_sim_time parameter -->
  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <!-- Load robot description -->
  <param name="robot_description" command="$(find xacro)/xacro $(arg model)"/>

  <!-- Start Gazebo -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- Spawn robot in Gazebo -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model" 
        args="-urdf -model agf_model -x $(arg x) -y $(arg y) -z $(arg z) 
              -R $(arg roll) -P $(arg pitch) -Y $(arg yaw) -param robot_description" 
        output="screen"/>

  <!-- Robot state publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
  </node>

  <!-- Joint state publisher -->
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
    <param name="use_sim_time" value="$(arg use_sim_time)"/>
  </node>

  <!-- Load controller configuration -->
  <rosparam file="$(find agf_gazebo_sim)/config/agf_controllers.yaml" command="load"/>

  <!-- Controller spawners -->
  <node name="controller_spawner" pkg="controller_manager" type="spawner"
        args="joint_state_controller 
              left_steering_position_controller right_steering_position_controller
              front_left_wheel_velocity_controller front_right_wheel_velocity_controller
              rear_left_wheel_velocity_controller rear_right_wheel_velocity_controller
              --namespace=/agf_model" 
        output="screen" respawn="false"/>
        
  <!-- Ackermann Steering Node to convert cmd_vel to proper wheel/steering commands -->
  <node pkg="agf_gazebo_sim" type="ackermann_steering_node.py" name="ackermann_steering_node" output="screen"/>

  <!-- Teleop twist keyboard for testing -->
  <!-- <node pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" name="teleop_twist_keyboard"
        output="screen">
    <remap from="cmd_vel" to="/cmd_vel"/>
  </node> -->

</launch>