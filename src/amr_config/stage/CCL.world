include "robots/forklift_robot.inc"


define floorplan model
(
  # sombre, sensible, artistic
  color "gray30"

  # most maps will need a bounding box
  boundary 1

  gui_nose 0
  gui_grid 0
  gui_move 0
  gui_outline 0
  gripper_return 0
  fiducial_return 0
  laser_return 1
)

resolution 0.01
interval_sim 100  # simulation timestep in milliseconds

window
(
  size [ 600 700 ]
  center [ 1.668 0.306 ]
  rotate [ 2.500 180.000 ]
  scale 180
  show_data 1 # show laser data
)

floorplan
(
  name "maptest"
  bitmap "../maps/CCL.pgm"
  size [ 73.200 39.950 0.500 ]
  # pose [ 32.95 12.3 0 0 ]
  pose [ 32.950 12.300 0.000 180.000 ]
)

# throw in a robot
forklift_robot
(
  pose [ 1.520 -0.216 0.000 1.319 ]
  name "robot"
)
