<launch>
	<arg name="device" default="/dev/video4"/>
	<arg name="camera_info_url" default="package://amr_config/cfg/fiducial/calibration.ini"/>
	<arg name="frame_id" default="head_camera"/>
	<!-- Launch the usb camera acquisition node -->
	<node pkg="usb_cam" type="usb_cam_node" name="usb_cam" output="screen">
	  <param name="camera_frame_id" value="$(arg frame_id)"/>
	  <param name="image_width" value="640" />
	  <param name="image_height" value="480" />
	  <param name="video_device" value="$(arg device)" />
	  <param name="pixel_format" value="yuyv" />
	  <!-- rename the camera name topic into /camera/image_raw to match the one in visp_auto_tracker/models/calibration.ini file -->
	  <param name="camera_name" value="camera" />
	  <param name="camera_info_url" value="package://amr_config/cfg/fiducial/calibration.ini" type="string" />
	  <remap from="/usb_cam/camera_info" to="/camera/camera_info"/>
	  <remap from="/usb_cam/image_raw" to="/camera/image_raw/"/>
	  <remap from="/camera/image_raw/compressed" to="/camera/image/compressed"/>
	</node>
  </launch>
