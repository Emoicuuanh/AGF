<launch>
    <arg name="ipaddress" default="192.168.0.50" />
    <arg name="port" default="2112" />
    <arg name="layer" default="0" />
    <arg name="subfix" default="py" />

    <node pkg="nav350" name="nav350" type="nav350_node.$(arg subfix)" output="screen">
        <param name="ipaddress" value="$(arg ipaddress)" />
        <param name="port" value="$(arg port)" />
        <param name="layer" value="$(arg layer)" />
        <remap from="scan" to="scan_nav350" />
    </node>
</launch>