<launch>
    <arg name="cfg_file" default="$(find amr_config)/cfg/transform.yaml"/>

    <node name="odometry" pkg="odometry_calculate" type="odometry.py" output="screen">
        <param name="use_absolute_odom" value="false"/>
        <param name="use_encoder_odom" value="true"/>
        <rosparam file="$(arg cfg_file)"/>
    </node>
</launch>