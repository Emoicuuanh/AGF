<launch>
    <arg name="pkg" value="olelidar"/>

    <arg name="debug" default="false"/>
    <env if="$(arg debug)" name="ROSCONSOLE_CONFIG_FILE" value="$(find olelidar)/launch/debug.conf"/>

    <!-- Params for each decoder node, keyed by node name -->
    <rosparam command="load" file="$(find amr_config)/cfg/olelidar/olelidar.yaml" />

    <!-- <node pkg="$(arg pkg)" type="$(arg pkg)_decoder" name="$(arg pkg)_decoder_1" output="screen">
      <remap from="~packet" to="packet"/>
      <remap from="~scan" to="scan_1"/>
    </node> -->

    <node pkg="$(arg pkg)" type="$(arg pkg)_decoder" name="$(arg pkg)_decoder_2" output="screen">
      <remap from="~packet" to="packet"/>
      <remap from="~scan" to="scan_2"/>
    </node>

  </launch>
