<launch>
  <arg name="laser_1_ip" default="192.168.0.60"/>
  <!-- <arg name="laser_2_ip" default="192.168.0.61"/> -->

  <node name="sick_tim_7xx_1" pkg="sick_scan" type="sick_generic_caller"  respawn="false" output="screen">
    <param name="scanner_type" type="string" value="sick_tim_7xx" />
    <param name="frame_id" value="laser_3"/>
    <param name="min_ang" type="double" value="-2.1" /><!-- -135° -->
    <param name="max_ang" type="double" value="2.1" /><!-- 135° ~ 2.35619449-->
    <param name="range_max" type="double" value="100.0" />
    <param name="intensity" type="bool" value="True" />
    <param name="hostname" type="string" value="$(arg laser_1_ip)" />
    <param name="port" type="string" value="2112" />
    <param name="timelimit" type="int" value="5" />
    <remap from="scan" to="scan_3" />
    <remap from="cloud" to="cloud_3" />
    <remap from="encoder" to="sick_scan/encoder" />
  </node>

  <!-- <node name="sick_tim_7xx_2" pkg="sick_scan" type="sick_generic_caller"  respawn="false" output="screen">
    <param name="scanner_type" type="string" value="sick_tim_7xx" />
    <param name="frame_id" value="laser_2"/>
    <param name="min_ang" type="double" value="-2.1" />
    <param name="max_ang" type="double" value="2.1" />
    <param name="range_max" type="double" value="100.0" />
    <param name="intensity" type="bool" value="True" />
    <param name="hostname" type="string" value="$(arg laser_2_ip)" />
    <param name="port" type="string" value="2112" />
    <param name="timelimit" type="int" value="5" />
    <remap from="scan" to="scan_2" />
    <remap from="cloud" to="cloud_2" />
    <remap from="encoder" to="sick_scan/encoder" />
  </node> -->
</launch>