<?xml version="1.0"?>
<robot name="AGF">
  <!--Color define-->
  <material name="blue">
    <color rgba="0 0.8 0.8 1" />
  </material>

  <material name="white">
    <color rgba="1 1 1 1" />
  </material>

  <material name="black">
    <color rgba="0.066 0.066 0.066 1" />
  </material>

  <!--Link
  define-->
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://agf_description/meshes/agf.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="right_rear_lidar">
  </link>

  <link name="base_footprint">
  </link>

  <link name="left_rear_lidar">
  </link>

  <link name="front_lidar">
  </link>

  <link name="camera_front">
  </link>

  <link name="camera_back">
  </link>

  <link name="lidar_nav350">
  </link>

  <link name="wheel">
  </link>

  <link name="left_front_wheel">
  </link>

  <link name="right_front_wheel">
  </link>

  <joint name="footprint_to_base" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.105" />
  </joint>

  <joint name="base_to_lidar_nav350" type="fixed">
    <parent link="base_link" />
    <child link="lidar_nav350" />
    <origin xyz="1.060 0 1.864" />
  </joint>

  <joint name="base_to_wheel" type="fixed">
    <parent link="base_link" />
    <child link="wheel" />
    <origin xyz="1.311 0 0" />
  </joint>

  <joint name="base_to_left_wheel" type="fixed">
    <parent link="base_link" />
    <child link="left_front_wheel" />
    <origin xyz="0 0.5 0" />
  </joint>

  <joint name="base_to_right_wheel" type="fixed">
    <parent link="base_link" />
    <child link="right_front_wheel" />
    <origin xyz="0 -0.5 0" />
  </joint>


</robot>