  <!-- <link name="base_link"> -->
  <link name="base_footprint">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://agvlidar_description/meshes/bases/agvlidar_base_footprint.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>
  </link>
</robot>