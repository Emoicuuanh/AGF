<?xml version="1.0"?>

<launch>
  <!--PARAMETERS-->
  <param name="ini_filename" value="$(find amr_config)/cfg/agvlidar_navigation/icp_slam.init"/>
  <param name="odom_frame_id" value="odom"/>
  <param name="global_frame_id" value="map"/>
  <param name="use_odom" value="true"/>
  <param name="log_icp" value="false"/>
  <param name="base_frame_id" value="base_footprint"/>
  <param name="no_mirror" value="false"/>
  <!-- NAV350 odometry lost (mirror lost or no /nav350laser/odom for nav_odom_timeout s):
       use odom_imu (odometry_calculate/odom_imu.launch) as MRPT odometry instead -->
  <param name="use_imu_odom" value="true"/>
  <param name="imu_odom_topic" value="/odom_imu"/>
  <param name="nav_odom_timeout" value="0.5"/>
  <!-- /odom_imu step bigger than this between two messages (20 Hz) = odom_imu reset,
       MRPT re-aligns instead of treating it as motion -->
  <param name="imu_jump_dist" value="0.15"/>
  <param name="imu_jump_yaw" value="0.1"/>
  <!-- >20 to enable cut map 0 to enable all -->
  <param name="sizeMapErase" value="10"/>
  <param name="logicp_filename" value="/home/mkac/agf_app_ws/src/mrpt_slam/mrpt_icp_slam_2d/log_icp/log_icp.txt"/>
  <param name="PointCloudErase" value="3500"/>
  <!--for multiple sensors, place comma eg "r1/front_laser/scan,/beacon" -->
  <param name="sensor_source" value="/scan_nav350"/>
  <param name="trajectory_update_rate" value="5"/>
  <param name="trajectory_publish_rate" value="5"/>
  <env name="ROSCONSOLE_CONFIG_FILE" value="$(find mrpt_icp_slam_2d)/config/rosconsole.config"/>

  <!--SLAM RUN-->
  <!-- <node pkg="rviz" type="rviz" name="rviz_nav" output="screen" args="-d $(find mrpt_icp_slam_2d)/rviz/rviz_conf.rviz"></node> -->
  <node pkg="mrpt_icp_slam_2d" type="mrpt_icp_slam_2d" name="mrpt_icp_slam_2d" output="log">
    <!-- NAV350 -> base offset, shared with forklift_tf_publisher -->
    <rosparam file="$(find amr_config)/cfg/tf_agf_robot.yaml" command="load"/>
  </node>

</launch>