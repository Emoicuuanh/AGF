<launch>
	<arg name="map_file" default="CCL" />
	<arg name="subfix" default="py" />

	<node pkg="tf" type="static_transform_publisher" name="map_to_odom" output="screen"
		args="0 0 0 0 0 0 /map /odom 100" />
	<node pkg="tf" type="static_transform_publisher" name="odom_to_base_footprint" output="screen"
		args="0 0 0 0 0 0 /odom /base_footprint 100" />
	<node pkg="tf" type="static_transform_publisher" name="base_footprint_to_base_link"
		output="screen"
		args="0 0 0 0 0 0 /base_footprint /base_link 100" />

	<include file="$(find slam_manager)/launch/map_to_img.launch" />
	<node name="fake_status" pkg="agvlidar_common" type="fake_status.$(arg subfix)" output="screen" />
	<node pkg="map_server" name="map_server" type="map_server"
		args="$(find amr_config)/maps/$(arg map_file).yaml" />
</launch>